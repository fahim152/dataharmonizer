# =============================================================
# PRODUCTION HOST NGINX — Data Harmonizer
# =============================================================
#
# This config goes on your PRODUCTION SERVER's main nginx,
# NOT inside the Docker container (that has its own nginx.conf).
#
# ┌──────────────────────────────────────────────────┐
# │          HOW THE TRAFFIC FLOWS                   │
# │                                                  │
# │  Internet                                        │
# │    │                                             │
# │    ▼  :443 (HTTPS)                               │
# │  THIS CONFIG (host nginx)                        │
# │    │                                             │
# │    ▼  127.0.0.1:8080 (localhost only)            │
# │  .NET app + React SPA  (Docker container)        │
# └──────────────────────────────────────────────────┘
#
# ── SETUP STEPS ─────────────────────────────────────
#
#   1. Copy this file to your server:
#      scp nginx/production-host-nginx.conf.example user@server:/tmp/harmonizer
#
#   2. On the server, move it into nginx sites:
#      sudo cp /tmp/harmonizer /etc/nginx/sites-available/harmonizer
#
#   3. Edit it — replace harmonizer.yourdomain.com with your real subdomain:
#      sudo nano /etc/nginx/sites-available/harmonizer
#
#   4. Enable the site:
#      sudo ln -s /etc/nginx/sites-available/harmonizer /etc/nginx/sites-enabled/
#
#   5. Test and reload:
#      sudo nginx -t && sudo systemctl reload nginx
#
#   6. Get free SSL with certbot:
#      sudo certbot --nginx -d harmonizer.yourdomain.com
#      (certbot will auto-modify this file to add the SSL block)
#
#   7. Start the Docker project:
#      cd /path/to/dataharmonizer
#      cp .env.example .env   # edit if needed
#      docker-compose up --build -d
#
# =============================================================

# ── WebSocket upgrade mapping (required for SignalR) ──
# NOTE: If you already have this "map" block in your main
# nginx.conf or another site config, do NOT duplicate it.
# Check with:  grep -r "connection_upgrade" /etc/nginx/
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP server (port 80) ──
# After certbot runs, this block auto-redirects to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name harmonizer.yourdomain.com;   # ← CHANGE THIS

    # Certbot will replace the contents of this block with a 301 redirect.
    # Until then, proxy directly so you can test before SSL.
    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Pass real client info to the app
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # WebSocket support (SignalR)
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;

        # Long timeouts for SignalR persistent connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Buffering settings for real-time responses
        proxy_buffering    off;
        proxy_cache        off;
    }
}

# =============================================================
# ── HTTPS server (port 443) ──
# Certbot creates this automatically. If you want to set it up
# manually (e.g. with your own certs), uncomment below:
# =============================================================
#
